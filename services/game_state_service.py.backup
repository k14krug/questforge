
class GameStateService:
    def __init__(self, ai_service: AIService, socketio_instance=None): # Add socketio_instance
        self.ai_service = ai_service
        self.socketio = socketio_instance # Store it

    def add_item_to_player_inventory(self, game_player_id, item_name, item_description=None, quantity=1):
        """
        Adds an item to a specific player's inventory.
        Args:
            game_player_id: ID of the GamePlayer
            item_name: Name of the item to add
            item_description: Optional description of the item
            quantity: Number of items to add (default: 1)
        """
        game_player = GamePlayer.query.get(game_player_id)
        if not game_player:
            raise ValueError("GamePlayer not found")
        character_sheet = game_player.character_sheet or {}
        inventory = character_sheet.get('inventory', [])
        # Check if item already exists in inventory
        existing_item = next((item for item in inventory if (isinstance(item, dict) and item.get('name', '').lower() == item_name.lower()) or (isinstance(item, str) and item.lower() == item_name.lower())), None)
        if existing_item:
            if isinstance(existing_item, dict):
                existing_item['quantity'] = existing_item.get('quantity', 1) + quantity
            # If it's a string, convert to dict
            else:
                inventory.remove(existing_item)
                inventory.append({
                    'id': str(uuid.uuid4()),
                    'name': item_name,
                    'description': item_description or f"A {item_name.lower()}",
                    'quantity': quantity + 1,
                    'acquired_at': datetime.utcnow().isoformat()
                })
        else:
            inventory.append({
                'id': str(uuid.uuid4()),
                'name': item_name,
                'description': item_description or f"A {item_name.lower()}",
                'quantity': quantity,
                'acquired_at': datetime.utcnow().isoformat()
            })
        character_sheet['inventory'] = inventory
        game_player.character_sheet = character_sheet
        db.session.add(game_player)
        db.session.commit()
        logging.info(f"Added {quantity}x {item_name} to player {game_player_id}'s inventory")

import logging
import random
from database import db # Import db directly from database
from models import Game, GameState, GamePlayer
from services.ai_service import AIService
from datetime import datetime
import uuid

logging.basicConfig(level=logging.INFO, format='%(asctime)s - %(levelname)s - %(message)s')
    def __init__(self, ai_service: AIService, socketio_instance=None): # Add socketio_instance
        self.ai_service = ai_service
        self.socketio = socketio_instance # Store it

    def get_current_game_state(self, game_id):
        """Retrieves the current GameState for a given game."""
        game = Game.query.get(game_id)
        if not game:
            return None, "Game not found"
        
        logging.info(f"Attempting to retrieve GameState for game_id: {game_id}, current_game_state_id: {game.current_game_state_id}")
        game_state = GameState.query.get(game.current_game_state_id) if game.current_game_state_id else None
        
        if not game_state:
            logging.error(f"GameState not found for game {game_id} with current_game_state_id: {game.current_game_state_id}. Game might not have started or state is missing.")
            return None, "Current game state not found. Game might not have started or state is corrupted."
        
        return game_state, None

    def process_player_action(self, game_id, game_player_id, action_text):
        """
        Processes a player's action, potentially triggering AI skill checks and narrative.
        This is the core of the Action Resolution Workflow.
        """
        game = Game.query.get(game_id)
        if not game:
            return None, "Game not found"

        game_player = GamePlayer.query.get(game_player_id)
        if not game_player or game_player.game_id != game_id:
            return None, "Game player not found or not in this game"

        # Get current game state and charter for AI context
        current_game_state_obj = GameState.query.get(game.current_game_state_id) if game.current_game_state_id else None
        current_game_state_data = {
            "turn_number": current_game_state_obj.turn_number if current_game_state_obj else 0,
            "current_location": current_game_state_obj.current_location if current_game_state_obj else None,
            "active_npcs": current_game_state_obj.active_npcs if current_game_state_obj else [],
            "player_states": current_game_state_obj.player_states if current_game_state_obj else [],
            "game_log": current_game_state_obj.game_log if current_game_state_obj else [],
            "inventory": current_game_state_obj.inventory if current_game_state_obj else [],
        }
        logging.debug(f"Debug: current_game_state_data passed to AI: {current_game_state_data}")
        campaign_charter = game.campaign_charter
        
        # Check if the action indicates movement to a new location
        interactive_map_layout = campaign_charter.get('interactive_map_layout', {})
        target_location_node = self.analyze_action_for_movement(
            action_text, 
            current_game_state_data["current_location"], 
            interactive_map_layout
        )

        total_ai_cost = 0.0
        game_log_entries = []
        room_name = f"game_{game_id}" # Define room name for emits
        
        # Handle location movement if detected
        location_movement_occurred = False
        if target_location_node:
            try:
                old_location = current_game_state_data["current_location"]
                new_location = target_location_node.get('name')
                
                # Update the player's location
                self.update_player_location(game_id, new_location)
                
                # Update our local game state data for AI context
                current_game_state_data["current_location"] = new_location
                location_movement_occurred = True
                
                # Add a system message about the location change
                location_change_entry = {
                    "timestamp": datetime.utcnow().isoformat(),
                    "type": "SYSTEM_MESSAGE",
                    "actor": "System",
                    "content": f"Party moved from {old_location or 'starting location'} to {new_location}",
                    "details": {
                        "movement_type": "location_change",
                        "from": old_location,
                        "to": new_location,
                        "location_description": target_location_node.get('description', '')
                    }
                }
                game_log_entries.append(location_change_entry)
                
                logging.info(f"Location movement detected and processed: {old_location} -> {new_location}")
                
            except Exception as e:
                logging.error(f"Error updating player location: {e}")
                # Continue with normal processing even if location update fails

        # 1. Simulate AI Step 1: Check Identification
        ai_step1_response, cost_step1, _, _ = self.ai_service.process_action_step1_check_identification(
            player_action_text=action_text,
            game_state=current_game_state_data,
            charter=campaign_charter,
            character_sheet=game_player.character_sheet
        )
        total_ai_cost += cost_step1

        # Add player action to log
        player_action_log_entry = {
            "timestamp": datetime.utcnow().isoformat(),
            "type": "PLAYER_ACTION",
            "actor": game_player.character_name,
            "content": action_text,
            "details": {}
        }
        game_log_entries.append(player_action_log_entry)

        ai_narrative_response = ""

        if ai_step1_response.get("action_requires_roll"):
            skill_needed = ai_step1_response.get("skill")
            difficulty = ai_step1_response.get("difficulty")
            narration_prompt = ai_step1_response.get("narration_prompt")

            # Emit skill_check_initiated event
            if self.socketio:
                self.socketio.emit('skill_check_initiated', {
                    'game_id': game_id,
                    'game_player_id': game_player_id,
                    'character_name': game_player.character_name,
                    'skill_needed': skill_needed,
                    'difficulty': difficulty,
                    'message': f"{game_player.character_name} attempts a {skill_needed} check (Difficulty: {difficulty})."
                }, to=room_name)

            # 2. Look up player's skill bonus
            skill_bonus = game_player.character_sheet.get('skills', {}).get(skill_needed, 0)

            # 3. Simulate dice roll (1d20)
            dice_roll = random.randint(1, 20)
            
            # 4. Calculate final result
            total_result = dice_roll + skill_bonus

            # 5. Compare result to difficulty for outcome
            outcome = "Success" if total_result >= difficulty else "Failure"
            if dice_roll == 20:
                outcome = "Critical Success"
            elif dice_roll == 1:
                outcome = "Critical Failure"

            logging.info(f"Skill Check: {skill_needed}, Roll: {dice_roll}, Bonus: {skill_bonus}, Total: {total_result}, Difficulty: {difficulty}, Outcome: {outcome}")

            roll_result_data = {
                "skill": skill_needed,
                "roll": dice_roll,
                "skill_bonus": skill_bonus,
                "total_result": total_result,
                "difficulty": difficulty,
                "outcome": outcome
            }

            # Add system message for roll result to log
            game_log_entries.append({
                "timestamp": datetime.utcnow().isoformat(),
                "type": "SYSTEM_MESSAGE",
                "actor": "System",
                "content": f"Roll: {dice_roll} + {skill_needed}({skill_bonus}) = {total_result} (Difficulty: {difficulty}) -> {outcome}",
                "details": roll_result_data
            })
            
            # Emit dice_roll_result event
            if self.socketio:
                self.socketio.emit('dice_roll_result', {
                    'game_id': game_id,
                    'game_player_id': game_player_id,
                    'character_name': game_player.character_name,
                    **roll_result_data # Unpack the roll_result_data dictionary
                }, to=room_name)

            # Simulate AI Step 2: Outcome Narration
            ai_narrative_response, cost_step2, _, _ = self.ai_service.process_action_step2_outcome_narration(
                roll_result=roll_result_data,
                narration_prompt=narration_prompt,
                game_state=current_game_state_data,
                charter=campaign_charter
            )
            total_ai_cost += cost_step2

        else:
            # If no roll is required, AI directly narrates the outcome from Step 1's narration_prompt
            ai_narrative_response = ai_step1_response.get("narration_prompt")

        # Add AI narrative to game log
        game_log_entries.append({
            "timestamp": datetime.utcnow().isoformat(),
            "type": "GM_NARRATIVE",
            "actor": "AI",
            "content": ai_narrative_response,
            "details": {}
        })

        # Check for item gathering in the action and AI response
        detected_items = self.analyze_action_for_items(action_text, ai_narrative_response)
        if detected_items:
            # Decide target inventory: for demo, add to both party and player
            self.add_items_to_inventory_batch(game_id, detected_items, game_log_entries)
            for item in detected_items:
                self.add_item_to_player_inventory(game_player_id, item['name'], item.get('description'), item.get('quantity', 1))
            game_log_entries.append({
                "timestamp": datetime.utcnow().isoformat(),
                "type": "SYSTEM_MESSAGE",
                "actor": "System",
                "content": f"Added {', '.join([f'{item['name']} (x{item.get('quantity', 1)})' for item in detected_items])} to both party and player inventory.",
                "details": {"action_type": "item_acquired", "target": "both"}
            })

        # Update game's cumulative cost and save the new game log
        game.cumulative_cost += total_ai_cost
        current_game_state_obj.game_log = (current_game_state_obj.game_log or []) + game_log_entries
        current_game_state_obj.updated_at = datetime.utcnow()
        db.session.add(game)
        db.session.add(current_game_state_obj)
        db.session.commit()

        # Advance the turn to the next player
        self._advance_turn(game, current_game_state_obj)

        # After advancing the turn, emit the full game state to all clients
        if self.socketio:
            self.broadcast_game_state(game_id)

        return {
            "message": "Action processed",
            "ai_narrative": ai_narrative_response,
            "ai_cost": total_ai_cost,
            "game_log_entries": game_log_entries
        }, None

    def broadcast_game_state(self, game_id):
        """Fetches the current game state and broadcasts it to the room."""
        game = Game.query.get(game_id)
        if not game:
            logging.error(f"broadcast_game_state: Game not found for game_id {game_id}")
            return

        game_state, error = self.get_current_game_state(game_id)
        if error:
            logging.error(f"broadcast_game_state: Could not get game state for game_id {game_id}: {error}")
            return

        state_dict = game_state.to_dict()
        state_dict['players'] = [player.to_dict() for player in game.game_players]
        state_dict['campaign_charter'] = game.campaign_charter
        
        # Add all_objectives from campaign charter
        charter = game.campaign_charter
        if isinstance(charter, dict):
            state_dict['all_objectives'] = charter.get('critical_path_objectives') or charter.get('initial_state_elements', {}).get('initial_quests', [])
        else:
            state_dict['all_objectives'] = []

        logging.info(f"Broadcasting game_state_update for game {game_id} with data: {state_dict}")

        room_name = f"game_{game_id}"
        self.socketio.emit('game_state_update', state_dict, to=room_name)
        logging.info(f"Broadcasted game_state_update for game {game_id} to room {room_name}")

    def _advance_turn(self, game, current_game_state):
        """
        Advances the turn to the next player in the game.
        """
        players = sorted(game.game_players, key=lambda p: p.id) # Ensure consistent order
        if not players:
            logging.warning(f"Cannot advance turn in game {game.id}: no players found.")
            return

        current_player_id = current_game_state.current_player_id
        try:
            current_player_index = [p.user_id for p in players].index(current_player_id)
            next_player_index = (current_player_index + 1) % len(players)
        except ValueError:
            # If current player not found (e.g., they left), default to the first player
            next_player_index = 0

        next_player = players[next_player_index]
        
        # Update the game state
        current_game_state.current_player_id = next_player.user_id
        current_game_state.turn_number += 1
        current_game_state.updated_at = datetime.utcnow()
        db.session.add(current_game_state)
        db.session.commit()

        logging.info(f"Game {game.id} advanced to turn {current_game_state.turn_number}. Current player is now User ID: {next_player.user_id}")

    # NPC Management Methods

    def update_npc_status(self, game_id, npc_id, new_status):
        """
        Updates the status of an NPC in the current game state.
        
        Args:
            game_id: ID of the game
            npc_id: ID of the NPC to update
            new_status: New status for the NPC
            
        Raises:
            ValueError: If the NPC is not found
        """
        game_state, error = self.get_current_game_state(game_id)
        if error:
            raise ValueError(error)
            
        npcs = game_state.active_npcs or []
        npc = next((n for n in npcs if n.get('id') == npc_id), None)
        if not npc:
            raise ValueError(f"NPC {npc_id} not found")
            
        npc['status'] = new_status
        game_state.active_npcs = npcs
        db.session.add(game_state)
        db.session.commit()
        
        # Emit socket event
        if self.socketio:
            room_name = f"game_{game_id}"
            self.socketio.emit('npc_state_update', {
                'npc_id': npc_id,
                'update_type': 'status',
                'new_status': new_status,
                'timestamp': datetime.utcnow().isoformat()
            }, to=room_name)

    def move_npc(self, game_id, npc_id, new_location):
        """
        Moves an NPC to a new location in the current game state.
        
        Args:
            game_id: ID of the game
            npc_id: ID of the NPC to move
            new_location: New location for the NPC
            
        Raises:
            ValueError: If the NPC is not found
        """
        game_state, error = self.get_current_game_state(game_id)
        if error:
            raise ValueError(error)
            
        npcs = game_state.active_npcs or []
        npc = next((n for n in npcs if n.get('id') == npc_id), None)
        if not npc:
            raise ValueError(f"NPC {npc_id} not found")
            
        npc['location'] = new_location
        game_state.active_npcs = npcs
        db.session.add(game_state)
        db.session.commit()
        
        # Emit socket event
        if self.socketio:
            room_name = f"game_{game_id}"
            self.socketio.emit('npc_state_update', {
                'npc_id': npc_id,
                'update_type': 'location',
                'new_location': new_location,
                'timestamp': datetime.utcnow().isoformat()
            }, to=room_name)

    def add_npc_to_scene(self, game_id, npc_data):
        """
        Adds a new NPC to the current game state.
        
        Args:
            game_id: ID of the game
            npc_data: Dictionary containing NPC data
        """
        game_state, error = self.get_current_game_state(game_id)
        if error:
            raise ValueError(error)
            
        # Ensure NPC has required fields
        if 'id' not in npc_data:
            npc_data['id'] = str(uuid.uuid4())
        if 'status' not in npc_data:
            npc_data['status'] = 'active'
            
        npcs = game_state.active_npcs or []
        npcs.append(npc_data)
        game_state.active_npcs = npcs
        db.session.add(game_state)
        db.session.commit()
        
        # Emit socket event
        if self.socketio:
            room_name = f"game_{game_id}"
            self.socketio.emit('npc_added_to_scene', {
                'npc': npc_data,
                'timestamp': datetime.utcnow().isoformat()
            }, to=room_name)

    def remove_npc_from_scene(self, game_id, npc_id):
        """
        Removes an NPC from the current game state.
        
        Args:
            game_id: ID of the game
            npc_id: ID of the NPC to remove
            
        Raises:
            ValueError: If the NPC is not found
        """
        game_state, error = self.get_current_game_state(game_id)
        if error:
            raise ValueError(error)
            
        npcs = game_state.active_npcs or []
        new_npcs = [n for n in npcs if n.get('id') != npc_id]
        
        if len(new_npcs) == len(npcs):
            raise ValueError(f"NPC {npc_id} not found")
            
        game_state.active_npcs = new_npcs
        db.session.add(game_state)
        db.session.commit()
        
        # Emit socket event
        if self.socketio:
            room_name = f"game_{game_id}"
            self.socketio.emit('npc_removed_from_scene', {
                'npc_id': npc_id,
                'timestamp': datetime.utcnow().isoformat()
            }, to=room_name)

    def modify_npc_details(self, game_id, npc_id, updated_fields):
        """
        Modifies details of an existing NPC in the current game state.
        
        Args:
            game_id: ID of the game
            npc_id: ID of the NPC to update
            updated_fields: Dictionary of fields to update
            
        Raises:
            ValueError: If the NPC is not found
        """
        game_state, error = self.get_current_game_state(game_id)
        if error:
            raise ValueError(error)
            
        npcs = game_state.active_npcs or []
        npc = next((n for n in npcs if n.get('id') == npc_id), None)
        if not npc:
            raise ValueError(f"NPC {npc_id} not found")
            
        # Update fields
        for key, value in updated_fields.items():
            npc[key] = value
            
        game_state.active_npcs = npcs
        db.session.add(game_state)
        db.session.commit()
        
        # Emit socket event
        if self.socketio:
            room_name = f"game_{game_id}"
            self.socketio.emit('npc_details_updated', {
                'npc_id': npc_id,
                'updated_fields': updated_fields,
                'timestamp': datetime.utcnow().isoformat()
            }, to=room_name)

    def update_player_location(self, game_id, new_location):
        """
        Updates the player's current location in the game state.
        
        Args:
            game_id: ID of the game
            new_location: New location for the players
        """
        game_state, error = self.get_current_game_state(game_id)
        if error:
            raise ValueError(error)
            
        old_location = game_state.current_location
        game_state.current_location = new_location
        game_state.updated_at = datetime.utcnow()
        db.session.add(game_state)
        db.session.commit()
        
        # Emit socket event
        if self.socketio:
            room_name = f"game_{game_id}"
            self.socketio.emit('player_location_update', {
                'old_location': old_location,
                'new_location': new_location,
                'timestamp': datetime.utcnow().isoformat()
            }, to=room_name)
            
        logging.info(f"Player location updated in game {game_id}: {old_location} -> {new_location}")

    def analyze_action_for_movement(self, action_text, current_location, interactive_map_layout):
        """
        Analyzes a player action to see if it indicates movement to a new location.
        Returns the target location if movement is detected, None otherwise.
        """
        action_lower = action_text.lower()
        
        # Get available locations from the interactive map
        if not interactive_map_layout or 'nodes' not in interactive_map_layout:
            return None
            
        nodes = interactive_map_layout.get('nodes', [])
        edges = interactive_map_layout.get('edges', [])
        
        # Find current location node
        current_node = None
        if current_location:
            current_node = next((node for node in nodes if node.get('name', '').lower() == current_location.lower() or node.get('id', '').lower() == current_location.lower()), None)
        
        # Check for explicit movement keywords
        movement_keywords = [
            'travel to', 'move to', 'go to', 'head to', 'proceed to', 
            'continue to', 'advance to', 'walk to', 'run to', 'escape to'
        ]
        
        # Check for location names mentioned in action
        for node in nodes:
            node_name = node.get('name', '').lower()
            node_id = node.get('id', '').lower()
            
            # Check if location is mentioned in action
            if node_name in action_lower or node_id in action_lower:
                # Check if it's explicitly a movement action
                for keyword in movement_keywords:
                    if keyword in action_lower:
                        return node
                        
                # If current location is None (starting position), allow movement to any location
                if not current_location:
                    return node
                    
                # Check if it's a progressive movement (like "continue to escape pod bay")
                if any(word in action_lower for word in ['continue', 'proceed', 'advance', 'progress']):
                    # Verify it's a reachable location from current position
                    if current_node:
                        current_node_id = current_node.get('id')
                        reachable_nodes = [edge.get('to') for edge in edges if edge.get('from') == current_node_id]
                        if node.get('id') in reachable_nodes or not reachable_nodes:  # Allow if no edges defined
                            return node
                    else:
                        return node  # Allow movement if current location is unknown
        
        # Special case: if action mentions "escape pod" and there's a relevant location
        if 'escape pod' in action_lower:
            for node in nodes:
                node_name = node.get('name', '').lower()
                if 'escape' in node_name or 'pod' in node_name:
                    return node
                    
        return None

    # Inventory Management Methods

    def add_item_to_inventory(self, game_id, item_name, item_description=None, quantity=1):
        """
        Adds an item to the party's inventory.
        
        Args:
            game_id: ID of the game
            item_name: Name of the item to add
            item_description: Optional description of the item
            quantity: Number of items to add (default: 1)
        """
        game_state, error = self.get_current_game_state(game_id)
        if error:
            raise ValueError(error)
            
        inventory = game_state.inventory or []
        
        # Check if item already exists in inventory
        existing_item = next((item for item in inventory if item.get('name', '').lower() == item_name.lower()), None)
        
        if existing_item:
            # Update quantity if item exists
            existing_item['quantity'] = existing_item.get('quantity', 1) + quantity
        else:
            # Add new item
            new_item = {
                'id': str(uuid.uuid4()),
                'name': item_name,
                'description': item_description or f"A {item_name.lower()}",
                'quantity': quantity,
                'acquired_at': datetime.utcnow().isoformat()
            }
            inventory.append(new_item)
        
        game_state.inventory = inventory
        game_state.updated_at = datetime.utcnow()
        db.session.add(game_state)
        db.session.commit()
        
        # Emit socket event
        if self.socketio:
            room_name = f"game_{game_id}"
            self.socketio.emit('inventory_updated', {
                'action': 'item_added',
                'item_name': item_name,
                'quantity': quantity,
                'inventory': inventory,
                'timestamp': datetime.utcnow().isoformat()
            }, to=room_name)
            
        logging.info(f"Added {quantity}x {item_name} to inventory in game {game_id}")

    def remove_item_from_inventory(self, game_id, item_name, quantity=1):
        """
        Removes an item from the party's inventory.
        
        Args:
            game_id: ID of the game
            item_name: Name of the item to remove
            quantity: Number of items to remove (default: 1)
            
        Returns:
            bool: True if item was removed, False if not found or insufficient quantity
        """
        game_state, error = self.get_current_game_state(game_id)
        if error:
            raise ValueError(error)
            
        inventory = game_state.inventory or []
        
        # Find the item
        item = next((item for item in inventory if item.get('name', '').lower() == item_name.lower()), None)
        
        if not item:
            return False
            
        current_quantity = item.get('quantity', 1)
        if current_quantity < quantity:
            return False
            
        if current_quantity == quantity:
            # Remove item entirely
            inventory = [i for i in inventory if i.get('id') != item.get('id')]
        else:
            # Reduce quantity
            item['quantity'] = current_quantity - quantity
        
        game_state.inventory = inventory
        game_state.updated_at = datetime.utcnow()
        db.session.add(game_state)
        db.session.commit()
        
        # Emit socket event
        if self.socketio:
            room_name = f"game_{game_id}"
            self.socketio.emit('inventory_updated', {
                'action': 'item_removed',
                'item_name': item_name,
                'quantity': quantity,
                'inventory': inventory,
                'timestamp': datetime.utcnow().isoformat()
            }, to=room_name)
            
        logging.info(f"Removed {quantity}x {item_name} from inventory in game {game_id}")
        return True

    def add_items_to_inventory_batch(self, game_id, items, game_log_entries):
        """
        Adds multiple items to the party's inventory in a single transaction.
        
        Args:
            game_id: ID of the game
            items: List of items to add, each with 'name', 'description', and 'quantity'
            game_log_entries: List to append system messages to
        """
        if not items:
            return
            
        game_state, error = self.get_current_game_state(game_id)
        if error:
            logging.error(f"Error getting game state for batch inventory update: {error}")
            return
            
        inventory = game_state.inventory or []
        
        for item in items:
            try:
                item_name = item['name']
                item_description = item['description']
                quantity = item['quantity']
                
                # Check if item already exists in inventory
                existing_item = next((inv_item for inv_item in inventory if inv_item.get('name', '').lower() == item_name.lower()), None)
                
                if existing_item:
                    # Update quantity if item exists
                    existing_item['quantity'] = existing_item.get('quantity', 1) + quantity
                else:
                    # Add new item
                    new_item = {
                        'id': str(uuid.uuid4()),
                        'name': item_name,
                        'description': item_description or f"A {item_name.lower()}",
                        'quantity': quantity,
                        'acquired_at': datetime.utcnow().isoformat()
                    }
                    inventory.append(new_item)
                
                # Add a system message about the item acquisition
                game_log_entries.append({
                    "timestamp": datetime.utcnow().isoformat(),
                    "type": "SYSTEM_MESSAGE",
                    "actor": "System",
                    "content": f"Added {quantity}x {item_name} to inventory",
                    "details": {
                        "action_type": "item_acquired",
                        "item_name": item_name,
                        "quantity": quantity
                    }
                })
                logging.info(f"Auto-detected and added item: {quantity}x {item_name}")
                
            except Exception as e:
                logging.error(f"Error adding item {item.get('name', 'unknown')} in batch: {e}")
        
        # Save all changes in a single transaction
        game_state.inventory = inventory
        game_state.updated_at = datetime.utcnow()
        db.session.add(game_state)
        db.session.commit()
        
        # Emit socket event for all items
        if self.socketio:
            room_name = f"game_{game_id}"
            self.socketio.emit('inventory_updated', {
                'action': 'items_added_batch',
                'items': items,
                'inventory': inventory,
                'timestamp': datetime.utcnow().isoformat()
            }, to=room_name)

    def analyze_action_for_items(self, action_text, ai_narrative):
        """
        Analyzes player action and AI narrative to detect item gathering/usage.
        Returns a list of items that should be added to inventory.
        """
        action_lower = action_text.lower()
        narrative_lower = ai_narrative.lower()
        
        detected_items = []
        
        # Common item gathering keywords
        gathering_keywords = [
            'gather', 'collect', 'pick up', 'take', 'grab', 'acquire', 
            'find', 'discover', 'obtain', 'secure', 'retrieve'
        ]
        
        # Common item types with their descriptions
        item_patterns = {
            'emergency kit': 'A compact emergency survival kit containing basic medical supplies and tools',
            'toolbox': 'A sturdy toolbox containing various repair tools and equipment',
            'multitool': 'A versatile tool combining multiple functions in one device',
            'multi-tool': 'A versatile tool combining multiple functions in one device',
            'pry bar': 'A metal tool used for prying and leverage',
            'wire': 'Insulated wire for electrical connections and repairs',
            'insulated wire': 'Insulated wire for electrical connections and repairs',
            'rations': 'Emergency food rations for sustenance during long journeys',
            'access card': 'An electronic access card for restricted areas',
            'keycard': 'An electronic keycard for security doors',
            'flashlight': 'A portable light source for dark areas',
            'medkit': 'A medical kit containing healing supplies',
            'data pad': 'A portable device containing important information',
            'datapad': 'A portable device containing important information',
            'weapon': 'A tool for protection and combat',
            'ammunition': 'Ammunition for weapons',
            'rope': 'Sturdy rope for climbing and securing objects',
            'lockpick': 'Tools for bypassing locked mechanisms',
            'communicator': 'A device for long-range communication',
            'oxygen tank': 'A portable air supply for emergencies',
            'power cell': 'A portable energy source for electronic devices',
            'beacon': 'An emergency signaling device',
            'emergency beacon': 'An emergency signaling device'
        }
        
        # Check if action indicates gathering
        is_gathering_action = any(keyword in action_lower for keyword in gathering_keywords)
        
        if is_gathering_action:
            # Look for item mentions in both action and narrative
            combined_text = f"{action_lower} {narrative_lower}"
            
            for item_name, description in item_patterns.items():
                if item_name in combined_text:
                    # Determine quantity based on context
                    quantity = 1
                    if 'several' in combined_text or 'multiple' in combined_text:
                        quantity = 3
                    elif 'few' in combined_text:
                        quantity = 2
                    elif 'many' in combined_text or 'bunch' in combined_text:
                        quantity = 5
                    
                    detected_items.append({
                        'name': item_name.title(),
                        'description': description,
                        'quantity': quantity
                    })
        
        return detected_items

    def check_item_in_inventory(self, game_id, item_name):
        """
        Checks if an item exists in the party's inventory.
        
        Args:
            game_id: ID of the game
            item_name: Name of the item to check
            
        Returns:
            tuple: (bool, dict or None) - (exists, item_data)
        """
        game_state, error = self.get_current_game_state(game_id)
        if error:
            return False, None
            
        inventory = game_state.inventory or []
        
        # Find the item (case-insensitive)
        item = next((item for item in inventory if item.get('name', '').lower() == item_name.lower()), None)
        
        return item is not None, item

    def get_inventory_summary(self, game_id):
        """
        Gets a summary of the party's inventory for AI context.
        
        Args:
            game_id: ID of the game
            
        Returns:
            list: List of item names and quantities
        """
        game_state, error = self.get_current_game_state(game_id)
        if error:
            return []
            
        inventory = game_state.inventory or []
        return [f"{item.get('quantity', 1)}x {item.get('name', 'Unknown Item')}" for item in inventory]
